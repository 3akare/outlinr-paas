{
    email {$ACME_EMAIL}
    admin 0.0.0.0:2019
}

*.{$DOMAIN} {
    tls {
        dns cloudflare {$CF_API_TOKEN}
    }
}

{$DOMAIN} {
    tls {
        dns cloudflare {$CF_API_TOKEN}
    }
    # Forward all /api/* calls to Spring Boot
    handle /api/* {
        @oauth path_regexp oauth ^/api(?P<suffix>(?:/oauth2/|/login/oauth2/).*)$
        rewrite @oauth {re.oauth.suffix}
        reverse_proxy api:8080
    }
    
    # Serve static assets
    handle * {
        root * /usr/share/caddy
        file_server
    }
}
