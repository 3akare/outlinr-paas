# Stage 1: Build client static assets using Bun
FROM oven/bun:1.1-alpine AS client-builder
WORKDIR /app

COPY client/package.json client/bun.lock ./
RUN bun install --frozen-lockfile

COPY client/ .
RUN bun run build

# Stage 2: Build Caddy with Cloudflare DNS plugin
FROM caddy:builder AS caddy-builder
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

# Stage 3: Final Caddy image with static assets
FROM caddy:latest
COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy
COPY --from=client-builder /app/dist /usr/share/caddy
